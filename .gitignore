# Saltcode caches and dynamic workspace files
# Per-project convention: workspace/<project>/.saltcode/{tests/,cache/,calibration/}
# tests/ holds Test-Intent specs and is tracked; cache/ and calibration/ are generated.
.saltcode/cache/
.saltcode/calibration/
.saltcode/audit_log.jsonl
.saltcode/dry_run_log.txt
workspace/**/.saltcode/cache/
workspace/**/.saltcode/calibration/

# Pi project-local package settings (created by `pi install -l .`)
.pi/
